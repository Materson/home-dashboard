# ---- domain / network ----
PUBLIC_HOST=dashboard.example.com
# comma-separated; include the NAS LAN name / IP for local testing
DJANGO_ALLOWED_HOSTS=dashboard.example.com,nas.local,localhost
# comma-separated full origins (scheme + host) — used for CSRF + CORS
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com
SPA_ORIGIN=https://dashboard.example.com

# ---- django ----
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_DEBUG=0
# fernet key for EncryptedTextField, generated with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-fernet-key

# ---- database ----
# Dev on a laptop: leave DATABASE_URL commented out → the app uses SQLite
# (`backend/db.sqlite3`), no MariaDB required.
# Prod / docker-compose on the NAS: uncomment DATABASE_URL and the MARIADB_*
# vars below so the backend container can reach the `db` service.
MARIADB_DATABASE=home
MARIADB_USER=home
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root
# DATABASE_URL=mysql://home:change-me@db:3306/home

# ---- redis / celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- email (SMTP; Gmail app password works) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Home Dashboard <you@example.com>

# ---- web push (VAPID) ----
# generated once with: python -m webpush.manage_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=you@example.com

# ---- google calendar ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://dashboard.example.com/api/gcal/callback

# ---- slack bot (optional; Socket Mode) ----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# ---- AI providers (all optional; configured in Settings UI at runtime) ----
# These are only fallbacks for a provider profile that intentionally reads
# from env; normal setup is in the admin UI.

# ---- backups ----
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=30
BACKUP_PASSPHRASE=change-me-long-random
